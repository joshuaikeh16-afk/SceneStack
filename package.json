{
  "name": "scenestack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx",
    "test:db": "node --test --test-concurrency=1 supabase/tests/*.test.mjs",
    "test:catalog": "node --max-old-space-size=256 --import tsx --test --test-concurrency=1 tests/federated-feed.test.ts tests/catalog-runtime.test.ts tests/feed-pagination.test.ts tests/release-policy.test.ts",
    "test:browser": "node --max-old-space-size=128 scripts/run-browser-qa.mjs",
    "catalog:verify": "node --max-old-space-size=256 --conditions=react-server --env-file=.env.local --import tsx scripts/verify-catalog.ts",
    "test:light": "node --max-old-space-size=256 --import tsx --test --test-concurrency=1 --test-timeout=20000 tests/release-policy.test.ts tests/product.test.ts tests/offline.test.ts tests/presentation.test.ts tests/addendum-presentation.test.ts tests/redirect.test.ts tests/feed-pagination.test.ts",
    "db:validate": "node scripts/validate-migrations.mjs",
    "db:inventory": "node scripts/validate-migrations.mjs --inventory",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:check-types": "node scripts/generate-db-types.mjs --check",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check:source-secrets": "node --max-old-space-size=192 scripts/check-client-secrets.mjs --source-only",
    "db:preview": "node scripts/hosted-db.mjs preview",
    "db:deploy": "node scripts/hosted-db.mjs apply",
    "catalog:worker": "node --conditions=react-server --env-file=.env.local --import tsx scripts/catalog-worker.ts",
    "db:verify-hosted": "node scripts/verify-hosted-db.mjs",
    "catalog:jobs": "node --max-old-space-size=256 --conditions=react-server --env-file=.env.local --import tsx scripts/run-catalog-jobs.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/react-query": "^5.108.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}
