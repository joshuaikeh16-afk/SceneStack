# Required for Google authentication. Use your project's publishable key.
SCENESTACK_SITE_URL=https://scenestack.media
SCENESTACK_SUPPORT_EMAIL=scenestackcc@gmail.com
SCENESTACK_OPERATOR_NAME="Ikeh Joshua"
# Enable only on the approved canonical production deployment, never previews.
SCENESTACK_SEARCH_INDEXING=false
NEXT_PUBLIC_SUPABASE_URL=https://zyghuvjvelozjprdfula.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_p7EVqJ4DYBfbGmO34rqxfQ_ORBkPJ-z
SUPABASE_SECRET_KEY=
# Optional separate, random server-only cursor-signing secret (at least 24 characters).
# Dynamic discovery otherwise signs cursors with the configured Supabase secret.
CATALOG_CURSOR_SECRET=
SUPABASE_ACCESS_TOKEN=
# The access token is local operator access only. Never add it to Vercel.
# Server-only metadata token. Enable only after reviewing the applicable license.
TMDB_API_TOKEN=
TMDB_API_ENABLED=false
TMDB_LICENSE_CONFIRMED=false
# Distinct public redistribution approval. Credentials alone do not authorize it.
TMDB_PUBLIC_RELEASE_APPROVED=false
TMDB_BULK_INGESTION_APPROVED=false

# Irreversible cleanup remains disabled unless explicitly enabled by an operator.
SCENESTACK_ENABLE_ACCOUNT_PURGE=false

# Server-only public anime metadata. No MAL OAuth secret is required.
MAL_CLIENT_ID=
MAL_API_ENABLED=false
MAL_LICENSE_CONFIRMED=false
MAL_PUBLIC_RELEASE_APPROVED=false
MAL_BULK_INGESTION_APPROVED=false

# Optional scheduled platform work. Not required to open the Control Center.
# Keep disabled until migrations, scheduler configuration and provider permissions are verified.
SCENESTACK_JOBS_ENABLED=false
# Random server-only bearer secret, at least 32 characters. Never prefix NEXT_PUBLIC_.
CRON_SECRET=
